@model Gauniv.WebServer.Models.HomeViewModel
@using System.Globalization
@using X.PagedList.Mvc.Core
@using X.PagedList

@{
    ViewData["Title"] = "Accueil";
}
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

<h1>Liste des jeux</h1>

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col">
            <input type="text" name="filterName" value="@Model.FilterName" class="form-control" placeholder="Nom du jeu..." />
        </div>
        <div class="col">
            <input type="number" step="0.01" name="filterMinPrice" value="@Model.FilterMinPrice" class="form-control" placeholder="Prix min" />
        </div>
        <div class="col">
            <input type="number" step="0.01" name="filterMaxPrice" value="@Model.FilterMaxPrice" class="form-control" placeholder="Prix max" />
        </div>
        <div class="col">
            <select name="filterCategory" class="form-select">
                <option value="">Toutes les catégories</option>
                @foreach (var cat in Model.AvailableCategories)
                {
                    if (cat == Model.FilterCategory)
                    {
                        <option value="@cat" selected="selected">@cat</option>
                    }
                    else
                    {
                        <option value="@cat">@cat</option>
                    }
                }
            </select>
        </div>
        <div class="col">
            <select name="filterOwned" class="form-select">
                <option value="">Tous</option>
                @if (Model.FilterOwned == true)
                {
                    <option value="true" selected="selected">Possédés</option>
                }
                else
                {
                    <option value="true">Possédés</option>
                }

                @if (Model.FilterOwned == false)
                {
                    <option value="false" selected="selected">Non possédés</option>
                }
                else
                {
                    <option value="false">Non possédés</option>
                }
            </select>
        </div>
        <div class="col">
            <button type="submit" class="btn btn-primary w-100">Filtrer</button>
        </div>
    </div>
</form>


<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Description</th>
            <th>Prix</th>
            <th>Taille</th>
            <th>Catégories</th>
            <th>Possédé</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Games == null || !Model.Games.Any())
    {
        <tr>
            <td colspan="6" class="text-center">Aucun jeu trouvé</td>
        </tr>
    }
    else
    {
        @foreach (var game in Model.Games)
        {
            <tr>
                <td>@game.Name</td>
                <td>@game.Description</td>
                <td>@game.Price.ToString("0.00", CultureInfo.GetCultureInfo("fr-FR")) €</td>
                <td>
                    @{
                        double size = game.PayloadSize;
                        string displaySize;

                        if (size >= 1024 * 1024 * 1024)
                            displaySize = (size / (1024.0 * 1024.0 * 1024.0)).ToString("0.00", CultureInfo.GetCultureInfo("fr-FR")) + " Go";
                        else if (size >= 1024 * 1024)
                            displaySize = (size / (1024.0 * 1024.0)).ToString("0.00", CultureInfo.GetCultureInfo("fr-FR")) + " Mo";
                        else if (size >= 1024)
                            displaySize = (size / 1024.0).ToString("0.00", CultureInfo.GetCultureInfo("fr-FR")) + " Ko";
                        else
                            displaySize = size.ToString("0") + " octets";

                        @displaySize
                    }
                </td>
                <td>@(game.Categories != null && game.Categories.Any() ? string.Join(", ", game.Categories) : "-")</td>
                <td>@(game.Owned ? "Oui" : "Non")</td>
            </tr>
        }
    }
    </tbody>
</table>


@if (Model.Stats != null)
{
    <h1>Statistiques</h1>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary mb-3">
                <div class="card-header">Total de jeux</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.Stats.TotalGames</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-header">Moyenne de jeux par utilisateur</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.Stats.AvgGamesPerUser.ToString("0.00", CultureInfo.GetCultureInfo("fr-FR"))</h5>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-warning mb-3">
                <div class="card-header">Joueurs connectés</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.Stats.MaxSimultaneousPlayers</h5>
                </div>
            </div>
        </div>
    </div>

    <h3>Jeux par catégorie</h3>
    <div class="row">
        @foreach (var cat in Model.Stats.GamesPerCategory)
        {
            <div class="col-md-3 mb-2">
                <div class="card border-info">
                    <div class="card-body p-2">
                        <strong>@cat.CategoryName</strong> : @cat.Count jeu(s)
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Stats.MaxPlayersPerGame != null && Model.Stats.MaxPlayersPerGame.Any())
    {
        <h3 class="mt-4">Joueurs maximum par jeu</h3>
        <div class="row">
            @foreach (var game in Model.Stats.MaxPlayersPerGame)
            {
                <div class="col-md-3 mb-2">
                    <div class="card border-secondary">
                        <div class="card-body p-2">
                            <strong>@game.GameName</strong> : @game.MaxPlayers joueur(s)
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

